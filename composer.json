{
    "name": "wp-cli/google-sitemap-generator-cli",
    "description": "WP-CLI commend for google sitemap generator WordPress plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "WP-CLI Team",
            "homepage": "http://github.com/wp-cli",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.4",
        "wp-cli/wp-cli": "^2 || ^3"
    },
    "require-dev": {
        "wp-cli/extension-command": "^2 || ^3",
        "wp-cli/wp-cli-tests": "^4.3.4 || ^5"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        },
        "files": [
            "google-sitemap-generator-cli.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "behat": "run-behat-tests",
        "behat-rerun": "rerun-behat-tests",
        "lint": "run-linter-tests",
        "lint-gherkin": "run-gherkin-lint-tests",
        "phpcs": "run-phpcs-tests",
        "phpunit": "run-php-unit-tests",
        "prepare-tests": "install-package-tests",
        "test": [
            "@lint",
            "@lint-gherkin",
            "@phpcs",
            "@phpunit",
            "@behat"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
